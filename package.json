{
  "name": "@flashmandu/app-bridge",
  "version": "0.6.5",
  "description": "In-iframe App Bridge SDK for Flashmandu embedded apps. Drives the embedded app from inside the platform's iframe via postMessage.",
  "license": "proprietary",
  "author": "Flashmandu <engineering@flashmandu.com>",
  "homepage": "https://github.com/flashmandu-org/flashmandu-app-bridge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flashmandu-org/flashmandu-app-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/flashmandu-org/flashmandu-app-bridge/issues"
  },
  "keywords": [
    "flashmandu",
    "app-bridge",
    "embedded-app",
    "iframe",
    "postmessage",
    "storefront-apps"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./modal": {
      "types": "./dist/modal.d.ts",
      "import": "./dist/modal.js",
      "require": "./dist/modal.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "require": "./dist/next/index.cjs"
    },
    "./next/routes": {
      "types": "./dist/next/routes.d.ts",
      "import": "./dist/next/routes.js",
      "require": "./dist/next/routes.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "browser": "./dist/index.js",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run build && npm run verify:exports && npm run verify:framework-free && npm run size",
    "verify:exports": "node scripts/verify-exports.mjs",
    "verify:framework-free": "node scripts/verify-framework-free.mjs",
    "size": "node scripts/check-size.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
